+static int gc5035_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct gc5035 *gc5035 = to_gc5035(sd);
+	const struct gc5035_mode *mode = gc5035->cur_mode;
+
+	/* GC5035 is a fixed-size sensor without cropping; every mode maps
+	 * the full visible pixel array. Return the full-frame rectangle for
+	 * crop bounds, default crop and active crop alike.
+	 */
+	if (sel->target != V4L2_SEL_TGT_CROP &&
+	    sel->target != V4L2_SEL_TGT_CROP_DEFAULT &&
+	    sel->target != V4L2_SEL_TGT_CROP_BOUNDS)
+		return -EINVAL;
+
+	sel->r.left = 0;
+	sel->r.top = 0;
+	sel->r.width = mode->width;
+	sel->r.height = mode->height;
+
+	return 0;
+}
